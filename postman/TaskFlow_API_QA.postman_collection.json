{
  "info": {
    "_postman_id": "3dfdd859-0c23-4686-9be8-b798a111d18d",
    "name": "TaskFlow API QA - Portfolio Demo",
    "description": "Synthetic API QA engagement covering health, authentication, authorization, validation, pagination, CRUD workflows, and negative cases. Portfolio demonstration only; no real client data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 1000 ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"]},
            "description": "Confirms API availability and advertised version."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('Health contract is correct', () => {",
                  "    pm.expect(body.status).to.eql('ok');",
                  "    pm.expect(body.version).to.eql('1.0.0');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Valid login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Bearer token contract is correct', () => {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.token_type).to.eql('bearer');",
                  "});",
                  "pm.environment.set('access_token', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error is explicit', () => pm.expect(pm.response.json().detail).to.eql('Invalid credentials'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing password field",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Validation details are returned', () => pm.expect(pm.response.json().detail).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Users",
      "item": [
        {
          "name": "List users without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Token error is explicit', () => pm.expect(pm.response.json().detail).to.include('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users with pagination",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"}],
            "url": {
              "raw": "{{base_url}}/users?page=1&page_size=2",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{"key": "page", "value": "1"}, {"key": "page_size", "value": "2"}]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Two users are returned', () => pm.expect(body.items).to.have.lengthOf(2));",
                  "pm.test('Pagination metadata is correct', () => {",
                  "    pm.expect(body.pagination.page).to.eql(1);",
                  "    pm.expect(body.pagination.page_size).to.eql(2);",
                  "    pm.expect(body.pagination.total).to.eql(3);",
                  "});",
                  "pm.test('User object contract is present', () => pm.expect(body.items[0]).to.include.all.keys('id', 'name', 'email', 'role'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject page zero",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"}],
            "url": {"raw": "{{base_url}}/users?page=0", "host": ["{{base_url}}"], "path": ["users"], "query": [{"key": "page", "value": "0"}]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Boundary error is returned', () => pm.expect(pm.response.json().detail).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get existing user",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"}],
            "url": {"raw": "{{base_url}}/users/1", "host": ["{{base_url}}"], "path": ["users", "1"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Correct user is returned', () => pm.expect(body.id).to.eql(1));",
                  "pm.test('Email format is plausible', () => pm.expect(body.email).to.match(/^[^@]+@[^@]+$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown user",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"}],
            "url": {"raw": "{{base_url}}/users/999", "host": ["{{base_url}}"], "path": ["users", "999"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Not-found error is explicit', () => pm.expect(pm.response.json().detail).to.eql('User not found'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Tasks",
      "item": [
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Verify release candidate\",\n  \"priority\": \"high\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/tasks", "host": ["{{base_url}}"], "path": ["tasks"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Task contract is complete', () => pm.expect(body).to.include.all.keys('id', 'title', 'priority', 'status'));",
                  "pm.test('Task values are preserved', () => {",
                  "    pm.expect(body.title).to.eql('Verify release candidate');",
                  "    pm.expect(body.priority).to.eql('high');",
                  "    pm.expect(body.status).to.eql('open');",
                  "});",
                  "pm.environment.set('task_id', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject short task title",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"x\",\n  \"priority\": \"low\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/tasks", "host": ["{{base_url}}"], "path": ["tasks"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Validation error is returned', () => pm.expect(pm.response.json().detail).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}", "type": "text"}],
            "url": {"raw": "{{base_url}}/tasks/{{task_id}}", "host": ["{{base_url}}"], "path": ["tasks", "{{task_id}}"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));",
                  "pm.test('No body is returned', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
