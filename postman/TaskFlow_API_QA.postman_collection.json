        {
          "name": "List users with pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Two users are returned', () => pm.expect(body.items).to.have.lengthOf(2));",
                  "pm.test('Pagination metadata is correct', () => {",
                  "    pm.expect(body.pagination.page).to.eql(1);",
                  "    pm.expect(body.pagination.page_size).to.eql(2);",
                  "    pm.expect(body.pagination.total).to.eql(3);",
                  "});",
                  "pm.test('User object contract is present', () => pm.expect(body.items[0]).to.include.all.keys('id', 'name', 'email', 'role'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
